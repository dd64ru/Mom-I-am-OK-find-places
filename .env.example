# Copy to .env locally. No real credentials belong in this file or git.
GOOGLE_CLOUD_PROJECT=mom-im-ok-places
WORKSPACE_ID=
# Exactly one private group/supergroup. All human members may use the bot.
TELEGRAM_CHAT_ID=
TELEGRAM_BOT_USERNAME=
OPENAI_SESSION_DIR=.credentials
OPENAI_PROFILE=owner
# Run npm run oauth, then npm run models, and choose an available image-capable slug.
OPENAI_MODEL=
# Independent model-dependent Responses effort; unsupported combinations fail without downgrade.
OPENAI_REASONING_EFFORT=low
SECRET_SOURCE=google
GEMINI_FALLBACK_ENABLED=false
# Required only when fallback is enabled; use a currently available image-capable model ID.
GEMINI_MODEL=
# SECRET_SOURCE=env is an explicit local-only alternative to ADC/Secret Manager.
# TELEGRAM_BOT_TOKEN=
# GEMINI_API_KEY=
# Non-secret override only for owner reauthorization of the serverless registration.
# OPENAI_HOST_ID=the_stable_serverless_urn_uuid

# Non-secret, replaceable POI endpoint; see public Nominatim policy in docs/geography.md.
NOMINATIM_ENDPOINT=https://nominatim.openstreetmap.org
