{
  "name": "mom-im-ok-places",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/worker",
    "apps/functions"
  ],
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "npm run format:check && npm run typecheck && npm test && npm run infra:check",
    "oauth": "node --env-file-if-exists=.env apps/worker/dist/oauth-cli.js",
    "models": "node --env-file-if-exists=.env apps/worker/dist/models-cli.js",
    "vision:smoke": "node --env-file-if-exists=.env apps/worker/dist/vision-smoke-cli.js",
    "telegram:ids": "node --env-file-if-exists=.env apps/worker/dist/telegram-ids-cli.js",
    "preoauth": "npm run build",
    "premodels": "npm run build",
    "prevision:smoke": "npm run build",
    "pretelegram:ids": "npm run build",
    "infra:check": "bash scripts/check-infra.sh",
    "deploy:package": "node scripts/package-functions.mjs",
    "webhook": "node --env-file-if-exists=.env scripts/webhook-cli.mjs",
    "siwc:import": "node scripts/import-session.mjs",
    "presiwc:import": "npm run build",
    "workspace:init": "node scripts/workspace-init.mjs",
    "preworkspace:init": "npm run build",
    "test:rules": "METADATA_SERVER_DETECTION=none firebase emulators:exec --only firestore --project demo-places-tests \"node --test scripts/rules-tests.mjs\""
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "firebase-tools": "15.32.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  }
}
