rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function member(workspaceId) {
      return request.auth != null
        && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.members is list
        && request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.members;
    }
    match /workspaces/{workspaceId} {
      allow read: if request.auth != null && resource.data.members is list && request.auth.uid in resource.data.members;
      allow write: if false;
      match /places/{placeId} { allow read: if member(workspaceId); allow write: if false; }
      match /chains/{chainId} { allow read: if member(workspaceId); allow write: if false; }
      match /discoveries/{discoveryId} { allow read: if member(workspaceId); allow write: if false; }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
